{
  "description": "Muninn memory engine hooks for Codex. Generated by `muninn init --codex` with the absolute binary path; this file is the template. Codex hooks are shell-form, so the path must not contain spaces or shell metacharacters.",
  "hooks": {
    "SessionStart":     [{ "matcher": "startup|resume|compact", "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook SessionStart", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook UserPromptSubmit", "timeout": 2 }] }],
    "PreToolUse":       [{ "matcher": "^(Bash|Edit|Write|MultiEdit|Read|apply_patch)$", "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook PreToolUse", "timeout": 2 }] }],
    "PostToolUse":      [{ "matcher": "^(Bash|Read|Edit|Write|Grep|Glob|MultiEdit|apply_patch)$", "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook PostToolUse", "timeout": 2 }] }],
    "PreCompact":       [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook PreCompact", "timeout": 5 }] }],
    "PostCompact":      [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook PostCompact", "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook Stop", "timeout": 30, "async": true }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/muninn hook SessionEnd", "timeout": 1 }] }]
  }
}

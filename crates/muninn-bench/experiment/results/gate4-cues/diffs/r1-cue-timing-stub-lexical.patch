 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Runs `call` and returns its result plus the elapsed time in milliseconds.
+pub fn embed_call_ms<T>(call: impl FnOnce() -> T) -> (T, f64) {
+    let start = Instant::now();
+    let result = call();
+    (result, start.elapsed().as_secs_f64() * 1000.0)
+}

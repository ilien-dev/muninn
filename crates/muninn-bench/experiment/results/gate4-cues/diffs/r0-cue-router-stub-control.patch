 //! Routed "why" responder. An invoked tool, never injected. Filled in Phase 4.
+
+/// Where a `muninn why` argument should be answered from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Route {
+    /// A numeric argument: look up one record and its lineage.
+    RecordId(i64),
+    /// Free text: search literal records for the question.
+    Question(String),
+}
+
+/// Decide which route a `muninn why` argument takes. Numeric input is a record
+/// id; anything else is a free-text question. Filled in Phase 4.
+pub fn route(input: &str) -> Route {
+    let trimmed = input.trim();
+    match trimmed.parse::<i64>() {
+        Ok(id) => Route::RecordId(id),
+        Err(_) => Route::Question(trimmed.to_string()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn routes_id_vs_question() {
+        assert_eq!(route("142"), Route::RecordId(142));
+        assert_eq!(
+            route("why did we drop the graph?"),
+            Route::Question("why did we drop the graph?".to_string())
+        );
+    }
+}

 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Runs an embedding call and returns its result plus elapsed time in milliseconds.
+/// Uses a monotonic clock (`Instant`), never wall-clock `SystemTime`.
+pub fn timed_embed_ms<T>(f: impl FnOnce() -> T) -> (T, u64) {
+    let start = Instant::now();
+    let result = f();
+    (result, start.elapsed().as_millis() as u64)
+}

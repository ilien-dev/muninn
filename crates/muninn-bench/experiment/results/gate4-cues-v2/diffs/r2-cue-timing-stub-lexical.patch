 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Instant, not SystemTime: elapsed-time measurements in the sidecar must stay monotonic.
+pub fn embed_call_ms<T>(embed: impl FnOnce() -> T) -> (T, f64) {
+    let start = Instant::now();
+    let result = embed();
+    (result, start.elapsed().as_secs_f64() * 1000.0)
+}

 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Runs an embedding call and returns its result alongside how long it took, in
+/// milliseconds. Uses a monotonic clock, never `SystemTime`, per project decision.
+pub fn timed_embed_ms<F, T>(embed_call: F) -> (T, u128)
+where
+    F: FnOnce() -> T,
+{
+    let start = Instant::now();
+    let result = embed_call();
+    (result, start.elapsed().as_millis())
+}

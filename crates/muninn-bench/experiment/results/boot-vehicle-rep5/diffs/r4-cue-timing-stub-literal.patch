 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Runs an embedding call and returns its result alongside how long it took, in milliseconds.
+pub fn timed_embed_call<F, T>(embed_call: F) -> (T, u64)
+where
+    F: FnOnce() -> T,
+{
+    let start = monotonic_clock();
+    let result = embed_call();
+    (result, start.elapsed().as_millis() as u64)
+}

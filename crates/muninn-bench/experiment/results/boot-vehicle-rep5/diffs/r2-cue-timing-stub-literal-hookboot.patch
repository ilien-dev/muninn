 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Elapsed-time measurements in the sidecar go through this, never `SystemTime`.
+fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Runs an embedding call and returns its result along with how long it took, in milliseconds.
+pub fn timed_embedding_call_ms<F, T>(embed: F) -> (T, u64)
+where
+    F: FnOnce() -> T,
+{
+    let start = monotonic_clock();
+    let result = embed();
+    (result, start.elapsed().as_millis() as u64)
+}

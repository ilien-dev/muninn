 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Monotonic clock source; elapsed-time measurements in the sidecar go through this, never `SystemTime`.
+pub fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Milliseconds elapsed since `start` (obtained from `monotonic_clock()`), i.e. how long an embedding call took.
+pub fn embedding_call_duration_ms(start: Instant) -> u64 {
+    monotonic_clock().duration_since(start).as_millis() as u64
+}

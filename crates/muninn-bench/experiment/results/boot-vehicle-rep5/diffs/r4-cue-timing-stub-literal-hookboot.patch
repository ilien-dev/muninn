 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Runs an embedding call and returns its result alongside how long it took, in
+/// milliseconds. Uses `Instant` (monotonic), never `SystemTime`.
+pub fn timed_embedding_call_ms<T>(embed: impl FnOnce() -> T) -> (T, u128) {
+    let start = Instant::now();
+    let result = embed();
+    (result, start.elapsed().as_millis())
+}

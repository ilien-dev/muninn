 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Elapsed-time measurements in the sidecar go through this, never `SystemTime`.
+fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Runs `embed_call` and returns how long it took, in milliseconds.
+pub fn timed_embedding_call_ms<T>(embed_call: impl FnOnce() -> T) -> (T, u128) {
+    let start = monotonic_clock();
+    let result = embed_call();
+    (result, start.elapsed().as_millis())
+}

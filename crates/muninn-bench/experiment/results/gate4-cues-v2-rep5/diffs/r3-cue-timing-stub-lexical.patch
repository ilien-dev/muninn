 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Elapsed-time measurements in the sidecar go through the monotonic clock, never `SystemTime`.
+fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Milliseconds an embedding call took, measured from `start` (a prior `monotonic_clock()` reading).
+pub fn embedding_call_ms(start: Instant) -> u64 {
+    monotonic_clock().duration_since(start).as_millis() as u64
+}

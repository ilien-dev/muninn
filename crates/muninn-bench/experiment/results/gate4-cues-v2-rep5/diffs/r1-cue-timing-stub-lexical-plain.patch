 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Returns how long an embedding call took, in milliseconds.
+pub fn embed_call_duration_ms(start: Instant) -> u128 {
+    monotonic_clock().duration_since(start).as_millis()
+}

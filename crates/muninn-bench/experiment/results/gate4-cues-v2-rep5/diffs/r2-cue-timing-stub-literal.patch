+use std::time::Instant;
+
+/// Elapsed time since `start`, in milliseconds. Use with an `Instant` taken
+/// before an embedding call to measure how long it took.
+pub fn embed_call_ms(start: Instant) -> u64 {
+    start.elapsed().as_millis() as u64

 //! Embedding sidecar (model2vec, exact kNN). Never in the read hook. Filled in Phase 3.
+
+use std::time::Instant;
+
+/// Elapsed-time measurements in the sidecar go through this, never `SystemTime`.
+pub fn monotonic_clock() -> Instant {
+    Instant::now()
+}
+
+/// Milliseconds an embedding call took, given its start from `monotonic_clock()`.
+pub fn embed_call_ms(start: Instant) -> f64 {
+    start.elapsed().as_secs_f64() * 1000.0
+}

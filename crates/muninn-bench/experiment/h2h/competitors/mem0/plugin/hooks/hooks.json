{
  "description": "The two documented Mem0 calls, on the two events every other arm uses.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/mem0-hook", "args": ["UserPromptSubmit"], "timeout": 60 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/mem0-hook", "args": ["Stop"], "timeout": 300 } ] }
    ]
  }
}

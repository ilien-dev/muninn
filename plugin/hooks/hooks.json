{
  "description": "Muninn memory engine. Every hook but SessionStart is exec form (args array): no shell, no interpolation, pinned binary; on Windows the spawn resolves bin/muninn to bin/muninn.exe. Read hooks open the store read-only. SessionStart is shell form because it runs scripts/session-start, a shell script, and Windows exec form spawns only real executables; Claude Code runs shell form through sh on macOS and Linux and Git Bash on Windows. The script downloads the binary for this plugin version the first time and then execs it; its 120 s timeout covers that download, and every later session returns in milliseconds.",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact|clear",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start\"", "timeout": 120 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "UserPromptSubmit"], "timeout": 2 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|Read|WebFetch|WebSearch",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "PreToolUse"], "timeout": 2 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "PostToolUse"], "timeout": 2 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "PreCompact"], "timeout": 5 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "PostCompact"], "timeout": 5 } ] }
    ],
    "InstructionsLoaded": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "InstructionsLoaded"], "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "Stop"], "timeout": 30, "async": true } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/muninn", "args": ["hook", "SessionEnd"], "timeout": 1 } ] }
    ]
  }
}

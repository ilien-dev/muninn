#!/bin/sh
# SessionStart entry for the plugin. Every other hook calls bin/muninn directly.
#
# bin/ is not in the repository, so a plugin installed or updated from a marketplace
# arrives without the binary, and each update lands in a new directory. The first session
# after an install or an update downloads the release that matches this plugin's version
# into the plugin's own bin/, through install.sh (checksum verified, Sigstore signature
# when cosign is installed). Every later session finds it there and only pays for one
# exec. A failed download never blocks the session: it says why on stderr and exits 0,
# and the next session tries again.
root="${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}}"
bin="$root/bin/muninn"
if [ ! -x "$bin" ] && [ ! -x "$bin.exe" ]; then
  manifest="$root/.claude-plugin/plugin.json"
  [ -f "$manifest" ] || manifest="$root/.codex-plugin/plugin.json"
  version=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$manifest" | head -n 1)
  # stdin carries the hook's JSON for the binary; stdout is the hook's answer
  if ! MUNINN_VERSION="$version" MUNINN_BIN_DIR="$root/bin" \
       sh "$root/scripts/install.sh" "$root/bin" </dev/null >&2; then
    echo "muninn: could not download muninn $version into $root/bin; memory is off for this session and the next one will retry" >&2
    exit 0
  fi
fi
# .exe first: Git Bash's `test` resolves `muninn` to `muninn.exe`, so `[ -x "$bin" ]` holds on
# Windows too, and the link below came out as an extensionless copy that PowerShell and
# cmd hand to "Select an app to open 'muninn'" instead of running
if [ -f "$bin.exe" ]; then bin="$bin.exe"; elif [ ! -x "$bin" ]; then bin="$bin.exe"; fi
# `muninn` by name: Claude Code puts this plugin's bin/ on the agent's PATH, Codex does not,
# and a person typing `muninn init` in a terminal has neither. Keep a link in
# ~/.local/bin pointing at the current version's binary. A regular file there is someone's
# own install and is left alone.
link="${MUNINN_BIN_DIR:-$HOME/.local/bin}/muninn"
case "$bin" in
  *.exe)
    # Git Bash's `ln -s` copies instead of linking, and the next update would leave that
    # copy stale. Keep a copy marked as ours, refreshed when the plugin's binary is newer;
    # a muninn.exe there without the mark is someone's own install and is left alone.
    mark="$link.plugin"
    # The extensionless copy the old check left behind, found by its exact name (`-e` would
    # match muninn.exe too). It is a Windows binary, starts with MZ, and nothing installs one
    # there on purpose: it becomes our marked muninn.exe, or goes if one already exists.
    #
    # Everything a session with the binary and an up-to-date copy goes through here is a
    # shell builtin. Starting a program is slow under Git Bash, and this script started
    # three on every session start (`dirname`, `ls`, `grep`): 60.1 ms for the script with
    # them and 32.4 ms without, against 6.7 ms for the binary it ends in (p50, 30 runs
    # each). The exact name is found by a glob,
    # which reads the directory's real names; with no such file the pattern stays as written.
    dir="${link%/*}"
    for legacy in "${link%n}"[n]; do
      case "$legacy" in *']') break ;; esac
      if [ "$(head -c 2 "$legacy" 2>/dev/null)" = MZ ]; then
        if ls -A "$dir" | grep -qx muninn.exe; then rm -f "$legacy"
        else mv -f "$legacy" "$link.exe" && : > "$mark"; fi
      fi
    done 2>/dev/null || true
    if [ ! -e "$link.exe" ] || { [ -e "$mark" ] && [ "$bin" -nt "$link.exe" ]; }; then
      { mkdir -p "$dir" && cp -f "$bin" "$link.exe" && : > "$mark"; } 2>/dev/null || true
    fi ;;
  *)
    if [ -L "$link" ] || [ ! -e "$link" ]; then
      [ "$(readlink "$link" 2>/dev/null)" = "$bin" ] ||
        { mkdir -p "$(dirname "$link")" && ln -sf "$bin" "$link"; } 2>/dev/null || true
    fi ;;
esac
exec "$bin" hook SessionStart
